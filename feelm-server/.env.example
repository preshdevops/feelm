# Feelm Backend Server Environment Configuration

# Server Port & CORS Setup
PORT=5000
CORS_ORIGIN=http://localhost:5173

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# External AI & Movie API Keys (Server-side)
GEMINI_API_KEY=your_gemini_api_key_here
TMDB_API_KEY=your_tmdb_api_key_here

# Aiven / PostgreSQL Database Connection Setup
DB_HOST=your_db_host_here
DB_PORT=5432
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your_db_password_here

# Optional: CA Certificate String for SSL DB Connection
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
