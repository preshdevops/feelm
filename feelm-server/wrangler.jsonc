{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feelm-api",
  "main": "index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_server_modules"
  ],
  "vars": {
    "CORS_ORIGIN": "https://feelms.vercel.app"
  },
  "observability": {
    "enabled": false
  }
}
