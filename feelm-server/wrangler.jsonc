{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feelm-api",
  "main": "index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CORS_ORIGIN": "https://feelms.vercel.app"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "PASTE_THE_ID_FROM_STEP_1"
    }
  ],
  "observability": { "enabled": false }
}
